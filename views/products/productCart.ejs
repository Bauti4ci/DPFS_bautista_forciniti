<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/cartStyles.css' />
</head>

<body>
    <main>
        <%- include('../partials/header.ejs') %>


            <section>

                <h1>
                    <%= title %>
                </h1>

                <div class="cart">
                    <div class="cartList">
                        <% if (cart && cart.items && cart.items.length> 0) { %>
                            <% cart.items.forEach(item=> { %>
                                <span>
                                    <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>"
                                        class="cartProductImage">
                                    <div>
                                        <h3>
                                            <%= item.product.name %>
                                        </h3>
                                        <h4>$<%= item.unit_price %> x <%= item.quantity %> = $<%= (item.quantity *
                                                        item.unit_price).toFixed(2) %>
                                        </h4>
                                        <% const size=item.wearSize || item.footSize || item.size || item.weight; %>
                                            <% if (size) { %>
                                                <p>Talle/Tamaño: <%= size.value %>
                                                </p>
                                                <% } %>
                                    </div>

                                    <form action="/product/cart/remove/<%= item.id %>" method="POST">
                                        <button type="submit" class="deleteP acrilico"
                                            style="background: none; border: none; cursor: pointer; padding: 0;">
                                            <img src="/svg/x.svg" alt="Eliminar del carrito" style="display: block;">
                                        </button>
                                    </form>
                                </span>
                                <% }) %>
                                    <% } else { %>
                                        <p>Tu carrito está vacío.</p>
                                        <% } %>
                    </div>

                    <% if (cart && cart.items && cart.items.length> 0) { %>
                        <div class="payment">
                            <span>
                                <h4>Total:</h4>
                                <p>$<%= cart.items.reduce((acc, item)=> acc + (item.quantity * item.unit_price),
                                        0).toFixed(2) %></p>
                            </span>
                            <hr>
                            <span>
                                <h5>Metodo de pago</h5>
                                <p>+ Agregar Metodo</p>
                            </span>
                            <hr>
                            <span style="margin-top: 30px; justify-content: center;">
                                <button class="blackButton darkGlass"
                                    style="padding: 10px 15px; height: 40px; width: 80%;">Confirmar compra</button>
                            </span>
                        </div>
                        <% } %>
                </div>

            </section>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>

</html>