<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/create&editStyles.css' />
</head>

<body>

    <main>
        <%- include('../partials/header.ejs') %>
            <h1>
                <%= title %>
            </h1>
            <section>
                <form action="/product/new" method="post" enctype="multipart/form-data">
                    <span class="createSpan">
                        <label for="image">Subir Imagen</label>
                        <input type="file" id="image" name="image" class="imageUpload acrilico"
                            accept="image/png, image/jpeg">
                    </span>
                    <div class="createForm">
                        <div>
                            <span class="createSpan">
                                <label for="name">Nombre</label>
                                <input type="text" name="name" id="name" class="acrilico" required>
                            </span>
                            <span class="createSpan">
                                <label for="categorie">Categoría</label>
                                <select name="category_id" id="categorie" class="acrilico" required>
                                    <option value="" disabled selected>-- Elige una categoría --</option>
                                    <% categories.forEach(category=> { %>
                                        <option value="<%= category.id %>"
                                            data-name="<%= category.name.toLowerCase() %>">
                                            <%= category.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </span>
                        </div>
                        <div>
                            <span class="createSpan">
                                <label for="precio">Precio</label>
                                <input type="number" name="precio" id="precio" class="acrilico" step="0.01" required>
                            </span>
                            <span class="createSpan">
                                <label for="gender">Género</label>
                                <select name="gender_id" id="gender" class="acrilico" required>
                                    <option value="" disabled selected>-- Elige un género --</option>
                                    <% genders.forEach(gender=> { %>
                                        <option value="<%= gender.id %>">
                                            <%= gender.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </span>
                        </div>
                        <span class="createSpan">
                            <label for="color">Color</label>
                            <input type="text" name="color" id="color" class="acrilico">
                        </span>
                        <span class="createSpan">
                            <label for="bio">Descripción</label>
                            <textarea name="bio" id="bio" class="acrilico" required></textarea>
                        </span>
                    </div>

                    <div class="size-section" id="wear-sizes-section">
                        <p class="checkboxTittle">Talles de Indumentaria</p>
                        <div class="checkboxList">
                            <% wearSizes.forEach(size=> { %>
                                <div class="size-stock-item">
                                    <input type="checkbox" onchange="toggleStockInput(this)">
                                    <label>
                                        <%= size.value %>
                                    </label>
                                    <input type="number" name="stock[wear][<%= size.id %>]" placeholder="Stock"
                                        class="acrilico stock-input" min="0" value="0" disabled>
                                </div>
                                <% }); %>
                        </div>
                    </div>

                    <div class="size-section" id="foot-sizes-section">
                        <p class="checkboxTittle">Talles de Zapatillas</p>
                        <div class="checkboxList">
                            <% footSizes.forEach(size=> { %>
                                <div class="size-stock-item">
                                    <input type="checkbox" onchange="toggleStockInput(this)">
                                    <label>
                                        <%= size.value %>
                                    </label>
                                    <input type="number" name="stock[foot][<%= size.id %>]" placeholder="Stock"
                                        class="acrilico stock-input" min="0" value="0" disabled>
                                </div>
                                <% }); %>
                        </div>
                    </div>

                    <div class="size-section" id="weights-section">
                        <p class="checkboxTittle">Pesos</p>
                        <div class="checkboxList">
                            <% weights.forEach(size=> { %>
                                <div class="size-stock-item">
                                    <input type="checkbox" onchange="toggleStockInput(this)">
                                    <label>
                                        <%= size.value %>
                                    </label>
                                    <input type="number" name="stock[weight][<%= size.id %>]" placeholder="Stock"
                                        class="acrilico stock-input" min="0" value="0" disabled>
                                </div>
                                <% }); %>
                        </div>
                    </div>

                    <div class="size-section" id="sizes-section">
                        <p class="checkboxTittle">Tamaños</p>
                        <div class="checkboxList">
                            <% sizes.forEach(size=> { %>
                                <div class="size-stock-item">
                                    <input type="checkbox" onchange="toggleStockInput(this)">
                                    <label>
                                        <%= size.value %>
                                    </label>
                                    <input type="number" name="stock[size][<%= size.id %>]" placeholder="Stock"
                                        class="acrilico stock-input" min="0" value="0" disabled>
                                </div>
                                <% }); %>
                        </div>
                    </div>

                    <div class="submitButtonDiv">
                        <button type="submit" class="blackButton acrilico">Crear Producto</button>
                    </div>
                </form>
            </section>
    </main>

    <%- include('../partials/footer.ejs') %>

        <script>
            function toggleStockInput(checkbox) {
                const stockInput = checkbox.nextElementSibling.nextElementSibling;
                stockInput.disabled = !checkbox.checked;
                if (!checkbox.checked) {
                    stockInput.value = '0';
                }
            }

            function handleCategoryChange() {
                document.querySelectorAll('.size-section').forEach(section => {
                    section.style.display = 'none';
                });

                document.querySelectorAll('.size-section input[type="checkbox"]').forEach(cb => {
                    if (cb.checked) {
                        cb.checked = false;
                        toggleStockInput(cb);
                    }
                });

                const categorySelect = document.getElementById('categorie');
                const selectedOption = categorySelect.options[categorySelect.selectedIndex];

                if (!selectedOption || !selectedOption.dataset.name) {
                    return;
                }

                const categoryName = selectedOption.dataset.name;

                const categoryMap = {
                    'ropa': 'wear-sizes-section',
                    'zapatillas': 'foot-sizes-section',
                    'suplementos': 'sizes-section',
                    'snacks': 'sizes-section',
                    'equipo': 'weights-section'
                };

                const sectionId = categoryMap[categoryName];
                if (sectionId) {
                    document.getElementById(sectionId).style.display = 'block';
                }
            }

            document.addEventListener('DOMContentLoaded', handleCategoryChange);
            document.getElementById('categorie').addEventListener('change', handleCategoryChange);
        </script>
</body>

</html>


</html>