<!DOCTYPE html>
<html>

<head>
        <title>
                <%= title %>
        </title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel='stylesheet' href='/stylesheets/style.css' />
        <link rel='stylesheet' href='/stylesheets/create&editStyles.css' />
</head>

<body>
        <main>
                <%- include('../partials/header.ejs') %>
                        <h1>
                                <%= title %>
                        </h1>
                        <section>
                                <form action="/product/update/<%= product.id %>" method="POST"
                                        enctype="multipart/form-data">

                                        <span class="createSpan">
                                                <p style="margin-bottom: 5px; font-weight: bold;">Imagen Actual:</p>
                                                <img src="<%= product.image_url %>" alt="Imagen de <%= product.name %>"
                                                        width="150"
                                                        style="margin-bottom: 10px; border-radius: 4px; border: 1px solid #ddd;">
                                                <br>
                                                <label for="image">Subir Nueva Imagen (opcional)</label>
                                                <input type="file" id="image" name="image" class="imageUpload acrilico"
                                                        accept="image/png, image/jpeg">
                                        </span>

                                        <div class="createForm">
                                                <div>
                                                        <span class="createSpan">
                                                                <label for="name">Nombre</label>
                                                                <input type="text" name="name" id="name"
                                                                        class="acrilico" value="<%= product.name %>"
                                                                        required>
                                                        </span>
                                                        <span class="createSpan">
                                                                <label for="categorie">Categoría</label>
                                                                <select name="category_id" id="categorie"
                                                                        class="acrilico" required>
                                                                        <% allCategories.forEach(category=> { %>
                                                                                <option value="<%= category.id %>"
                                                                                        data-name="<%= category.name.toLowerCase() %>"
                                                                                        <%=(product.category_id===category.id)
                                                                                        ? 'selected' : '' %>>
                                                                                        <%= category.name %>
                                                                                </option>
                                                                                <% }); %>
                                                                </select>
                                                        </span>
                                                </div>
                                                <div>
                                                        <span class="createSpan">
                                                                <label for="precio">Precio</label>
                                                                <input type="number" name="precio" id="precio"
                                                                        class="acrilico" step="0.01"
                                                                        value="<%= product.price %>" required>
                                                        </span>
                                                        <span class="createSpan">
                                                                <label for="gender">Género</label>
                                                                <select name="gender_id" id="gender" class="acrilico"
                                                                        required>
                                                                        <% allGenders.forEach(gender=> { %>
                                                                                <option value="<%= gender.id %>"
                                                                                        <%=(product.gender_id===gender.id)
                                                                                        ? 'selected' : '' %>>
                                                                                        <%= gender.name %>
                                                                                </option>
                                                                                <% }); %>
                                                                </select>
                                                        </span>
                                                </div>
                                                <span class="createSpan">
                                                        <label for="color">Color</label>
                                                        <input type="text" name="color" id="color" class="acrilico"
                                                                value="<%= product.color %>">
                                                </span>
                                                <span class="createSpan">
                                                        <label for="bio">Descripción</label>
                                                        <textarea name="bio" id="bio" class="acrilico"
                                                                required><%= product.description %></textarea>
                                                </span>
                                        </div>

                                        <% const existingWearSizes=new Map(product.wearsizes.map(s=> [s.id,
                                                s.Product_wearsizes.stock]));
                                                const existingFootSizes = new Map(product.footsizes.map(s => [s.id,
                                                s.Product_footsizes.stock]));
                                                const existingWeights = new Map(product.weights.map(s => [s.id,
                                                s.Product_Weights.stock]));
                                                const existingSizes = new Map(product.sizes.map(s => [s.id,
                                                s.Product_Sizes.stock]));
                                                %>

                                                <div class="size-section" id="wear-sizes-section">
                                                        <p class="checkboxTittle">Talles y Stock</p>
                                                        <div class="checkboxList">
                                                                <% allWearSizes.forEach(size=> { %>
                                                                        <% const stock=existingWearSizes.get(size.id) ||
                                                                                0; %>
                                                                                <div class="size-stock-item">
                                                                                        <input type="checkbox"
                                                                                                onchange="toggleStockInput(this)"
                                                                                                <%=stock> 0 ? 'checked'
                                                                                        : '' %>>
                                                                                        <label>
                                                                                                <%= size.value %>
                                                                                        </label>
                                                                                        <input type="number"
                                                                                                name="stock[wear][<%= size.id %>]"
                                                                                                class="acrilico stock-input"
                                                                                                min="0"
                                                                                                value="<%= stock %>"
                                                                                                <%=stock> 0 ? '' :
                                                                                        'disabled' %>>
                                                                                </div>
                                                                                <% }); %>
                                                        </div>
                                                </div>

                                                <div class="size-section" id="foot-sizes-section">
                                                        <p class="checkboxTittle">Talles y Stock</p>
                                                        <div class="checkboxList">
                                                                <% allFootSizes.forEach(size=> { %>
                                                                        <% const stock=existingFootSizes.get(size.id) ||
                                                                                0; %>
                                                                                <div class="size-stock-item">
                                                                                        <input type="checkbox"
                                                                                                onchange="toggleStockInput(this)"
                                                                                                <%=stock> 0 ? 'checked'
                                                                                        : '' %>>
                                                                                        <label>
                                                                                                <%= size.value %>
                                                                                        </label>
                                                                                        <input type="number"
                                                                                                name="stock[foot][<%= size.id %>]"
                                                                                                class="acrilico stock"
                                                                                                min="0"
                                                                                                value="<%= stock %>"
                                                                                                <%=stock> 0 ? '' :
                                                                                        'disabled' %>>
                                                                                </div>
                                                                                <% }); %>
                                                        </div>
                                                </div>

                                                <div class="size-section" id="weights-section">
                                                        <p class="checkboxTittle">Pesos y Stock</p>
                                                        <div class="checkboxList">
                                                                <% allWeights.forEach(size=> { %>
                                                                        <% const stock=existingWeights.get(size.id) ||
                                                                                0; %>
                                                                                <div class="size-stock-item">
                                                                                        <input type="checkbox"
                                                                                                onchange="toggleStockInput(this)"
                                                                                                <%=stock> 0 ? 'checked'
                                                                                        : '' %>>
                                                                                        <label>
                                                                                                <%= size.value %>
                                                                                        </label>
                                                                                        <input type="number"
                                                                                                name="stock[weight][<%= size.id %>]"
                                                                                                class="acrilico stock-input"
                                                                                                min="0"
                                                                                                value="<%= stock %>"
                                                                                                <%=stock> 0 ? '' :
                                                                                        'disabled' %>>
                                                                                </div>
                                                                                <% }); %>
                                                        </div>
                                                </div>

                                                <div class="size-section" id="sizes-section">
                                                        <p class="checkboxTittle">Tamaños y Stock</p>
                                                        <div class="checkboxList">
                                                                <% allSizes.forEach(size=> { %>
                                                                        <% const stock=existingSizes.get(size.id) || 0;
                                                                                %>
                                                                                <div class="size-stock-item">
                                                                                        <input type="checkbox"
                                                                                                onchange="toggleStockInput(this)"
                                                                                                <%=stock> 0 ? 'checked'
                                                                                        : '' %>>
                                                                                        <label>
                                                                                                <%= size.value %>
                                                                                        </label>
                                                                                        <input type="number"
                                                                                                name="stock[size][<%= size.id %>]"
                                                                                                class="acrilico stock-input"
                                                                                                min="0"
                                                                                                value="<%= stock %>"
                                                                                                <%=stock> 0 ? '' :
                                                                                        'disabled' %>>
                                                                                </div>
                                                                                <% }); %>
                                                        </div>
                                                </div>

                                                <div class="submitButtonDiv">
                                                        <button type="submit" class="blackButton acrilico">Guardar
                                                                Cambios</button>
                                                </div>
                                </form>
                                <form action="/product/delete/<%= product.id %>" method="POST" style="display: inline;">
                                        <button type="submit" class="blackButton acrilico"
                                                onclick="return confirm('¿Estás seguro de que quieres borrar este producto?');">
                                                Eliminar Producto
                                        </button>
                                </form>
                        </section>
        </main>

        <%- include('../partials/footer.ejs') %>

                <script>
                        function toggleStockInput(checkbox) {
                                const stockInput = checkbox.nextElementSibling.nextElementSibling;
                                stockInput.disabled = !checkbox.checked;
                                if (!checkbox.checked) {
                                        stockInput.value = '0';
                                }
                        }

                        function handleCategoryChange() {
                                document.querySelectorAll('.size-section').forEach(section => {
                                        section.style.display = 'none';
                                });

                                const categorySelect = document.getElementById('categorie');
                                const selectedOption = categorySelect.options[categorySelect.selectedIndex];
                                if (!selectedOption || !selectedOption.dataset.name) return;

                                const categoryName = selectedOption.dataset.name;
                                const categoryMap = {
                                        'ropa': 'wear-sizes-section', 'zapatillas': 'foot-sizes-section',
                                        'suplementos': 'sizes-section', 'snacks': 'sizes-section', 'equipo': 'weights-section'
                                };

                                const sectionId = categoryMap[categoryName];
                                if (sectionId) {
                                        document.getElementById(sectionId).style.display = 'block';
                                }
                        }

                        document.addEventListener('DOMContentLoaded', handleCategoryChange);
                        document.getElementById('categorie').addEventListener('change', handleCategoryChange);
                </script>
</body>

</html>