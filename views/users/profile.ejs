<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/formStyles.css' />
    <link rel='stylesheet' href='/stylesheets/profileStyles.css' />


</head>

<body>

    <body>

        <main>
            <a href="/"><button class="goBack acrilico"><img src="/svg/leftarrow.svg" alt=""></button></a>

            <h1>
                <%= title %>
            </h1>
            <section>
                <img src="<%= userLogged.image %>" class="profileImage">
                <div class="bigContainer">
                    <div class="infoDiv">
                        <span>
                            <p>Nombre</p>
                            <h2>
                                <%= userLogged.firstNames %>
                            </h2>
                        </span>
                        <span>
                            <p>Apellido</p>
                            <h2>
                                <%= userLogged.lastNames %>
                            </h2>
                        </span>
                        <span>
                            <p>DNI</p>
                            <h2>
                                <%= userLogged.dni %>
                            </h2>
                        </span>
                    </div>
                    <div class="infoDiv">
                        <span>
                            <p>Email</p>
                            <h2>
                                <%= userLogged.email %>
                            </h2>
                        </span>
                        <span>
                            <p>Número</p>
                            <h2>
                                <%= userLogged.number %>
                            </h2>
                        </span>
                    </div>
                </div>



            </section>

            <div class="profileOptions">

                <a href="/product/cart"><button class="blackButton glass"><svg xmlns="http://www.w3.org/2000/svg"
                            width="16" height="16" fill="currentColor" class="bi bi-bag-fill" viewBox="0 0 16 16"
                            alt="carrito">
                            <path
                                d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4z" />
                        </svg></button></a>
                <a href="/users/login"><button class="blackButton glass">Log out</button></a>
            </div>


        </main>

        <%- include('../partials/footer.ejs') %>
    </body>
</body>

</html>